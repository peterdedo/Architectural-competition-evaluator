{
  "name": "urban-analysis-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:proxy": "node server/openai-proxy.mjs",
    "dev:api": "node server/api-dev-server.mjs",
    "dev:vite": "vite",
    "dev": "concurrently -k -n proxy,api,vite -c blue,magenta,green \"npm run dev:proxy\" \"npm run dev:api\" \"vite\"",
    "build": "vite build",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:create-user": "node scripts/create-user.mjs"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.1",
    "framer-motion": "^12.23.24",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^1.0.0"
  }
}
